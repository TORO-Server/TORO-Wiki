# Cloudflare Pages / Workers Environment Variables

# --- Discord OAuth2 設定 ---
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# コールバック URL (未指定時はリクエスト元 origin/api/auth/callback が自動適用されます)
# DISCORD_REDIRECT_URI=https://wiki.torosaba.net/api/auth/callback

# TORO Server の Discord ギルド ID (参加者のみに編集を制限する場合)
DISCORD_GUILD_ID=your_toro_server_guild_id

# 編集権限を付与する特定のロール ID (任意: 指定したロールを持つユーザーのみ編集可能)
# DISCORD_REQUIRED_ROLE_ID=your_editor_role_id

# ギルド参加確認のフォールバック用ボットトークン (任意)
# DISCORD_BOT_TOKEN=your_discord_bot_token

# --- GitHub API 設定 ---
# 書き込み権限 (Contents: Read & Write) を持った Fine-grained Personal Access Token
GITHUB_TOKEN=github_pat_xxxxxx
GITHUB_OWNER=TORO-Server
GITHUB_REPO=TORO-Wiki
GITHUB_BRANCH=main

# --- セッション・暗号化設定 ---
# 署名用シークレットキー (ランダムな英数字文字列)
JWT_SECRET=generate_a_secure_random_string_here

# Cookie ドメイン (任意: .torosaba.net など)
# COOKIE_DOMAIN=.torosaba.net
